<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Pinfinity X local manifest additions.
       This repository IS the Pinfinity X vendor layer, cloned into the
       ROM tree as vendor/pinfinity -->

  <remote name="pinfinity"
          fetch="https://github.com/MiniVoidyy" />

  <project path="vendor/pinfinity"
           name="Pinfinity-x-"
           remote="pinfinity"
           revision="main" />

  <!-- kernel_samsung_exynos9810-V2 upstream is an empty placeholder;
       use the real kernel tree instead -->
  <remove-project name="kernel_samsung_exynos9810-V2" />
  <project path="kernel/samsung/exynos9810"
           name="kernel_samsung_exynos9810"
           remote="edsheeran"
           revision="thirteen" />

  <!-- PE's gitlab.pixelexperience.org is dead (org archived 2024);
       this extra is unused by our device trees -->
  <remove-project name="external_faceunlock" />
</manifest>
